{
  "name": "promptguild",
  "version": "0.1.0",
  "description": "Turn one natural-language prompt into a Discord server blueprint, preview it, and provision it through an official bot.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MichaelMattern/PromptGuild.git"
  },
  "bugs": {
    "url": "https://github.com/MichaelMattern/PromptGuild/issues"
  },
  "homepage": "https://github.com/MichaelMattern/PromptGuild#readme",
  "keywords": [
    "discord",
    "discord-bot",
    "discord-js",
    "ai-agent",
    "ai-tools",
    "server-builder",
    "community-management",
    "ollama",
    "openai",
    "local-ai",
    "automation",
    "no-code",
    "self-hosted",
    "open-source",
    "typescript"
  ],
  "main": "dist/index.js",
  "type": "commonjs",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx src/cli.ts",
    "setup": "tsx src/cli.ts setup",
    "setup:dry-run": "tsx src/cli.ts setup --dry-run",
    "generate-blueprint": "tsx src/cli.ts generate-blueprint",
    "validate-blueprint": "tsx src/cli.ts validate-blueprint",
    "reset-state": "tsx src/cli.ts reset-state",
    "ui": "tsx src/web/server.ts",
    "start": "node dist/web/server.js",
    "docker:build": "docker build -t promptguild:latest .",
    "docker:up": "docker compose up --build",
    "docker:down": "docker compose down"
  },
  "dependencies": {
    "discord.js": "^14.16.3",
    "dotenv": "^16.4.7",
    "openai": "^4.77.0",
    "yaml": "^2.6.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  },
  "overrides": {
    "undici": "6.27.0"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT"
}
